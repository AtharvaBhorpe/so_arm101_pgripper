<?xml version="1.0"?>
<robot name="so_arm101_pgripper">
  <group name="arm">
    <chain base_link="base_link" tip_link="gripper_frame_link"/>
  </group>
  <group name="gripper">
    <joint name="gripper"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="shoulder_pan" value="0"/>
    <joint name="shoulder_lift" value="0"/>
    <joint name="elbow_flex" value="0"/>
    <joint name="wrist_flex" value="0"/>
    <joint name="wrist_roll" value="0"/>
  </group_state>
  <group_state name="zero" group="arm">
    <joint name="shoulder_pan" value="-0.076699"/>
    <joint name="shoulder_lift" value="-1.70"/>
    <joint name="elbow_flex" value="1.560058"/>
    <joint name="wrist_flex" value="0.408039"/>
    <joint name="wrist_roll" value="-0.009204"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="gripper" value="0"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper" value="2.2028"/>
  </group_state>

  <end_effector name="pgripper" parent_link="gripper_frame_link" group="gripper" parent_group="arm"/>
  <passive_joint name="pgripper_left_finger_joint"/>
  <passive_joint name="pgripper_right_finger_joint"/>

  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="lower_arm_link" reason="Adjacent"/>
  <disable_collisions link1="lower_arm_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="pgripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="pgripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="pgripper_base_link" link2="pgripper_servo_link" reason="Adjacent"/>
  <disable_collisions link1="pgripper_base_link" link2="pgripper_left_jaw_link" reason="Adjacent"/>
  <disable_collisions link1="pgripper_base_link" link2="pgripper_right_jaw_link" reason="Adjacent"/>
  <disable_collisions link1="pgripper_servo_link" link2="pgripper_gear_link" reason="Adjacent"/>
  <disable_collisions link1="pgripper_gear_link" link2="pgripper_left_jaw_link" reason="Adjacent"/>
  <disable_collisions link1="pgripper_gear_link" link2="pgripper_right_jaw_link" reason="Adjacent"/>
</robot>
